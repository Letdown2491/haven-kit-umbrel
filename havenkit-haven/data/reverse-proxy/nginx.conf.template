# Reverse proxy routes Umbrel ingress to Haven services.
# - Clearnet hosts (Umbrel dashboard) → configuration UI on port 8080
# - Tor hidden service host → Haven relay (websocket + Blossom) on port 3355

map $host $haven_upstream {
    default config_ui:8080;
    ${APP_HIDDEN_SERVICE:-tor-disabled.local} haven_relay:3355;
}

server {
    listen 8080 default_server;
    server_name _;

    location / {
        proxy_pass http://$haven_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
