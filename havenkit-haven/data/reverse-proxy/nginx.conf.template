# Reverse proxy routes Umbrel ingress to Haven services.
# - Clearnet hosts (Umbrel dashboard) → configuration UI on port 8080
# - Tor hidden service host → Haven relay (websocket + Blossom) on port 3355

server {
    listen 80;
    server_name
        ${DEVICE_HOSTNAME}
        ${DEVICE_HOSTNAME}.local
        ${DEVICE_DOMAIN_NAME}
        umbrel.local
        localhost
        127.0.0.1;

    location / {
        proxy_pass http://config_ui:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name ${APP_HIDDEN_SERVICE};

    location / {
        proxy_pass http://haven_relay:3355;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80 default_server;
    return 403;
}
